# Copy to .env.local and fill in. Never commit real values.
# Save Slot only — never reuse values from any other project.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Save Slot project in the MerijnBiz organization)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server-only

# External data (server-only, optional). A provider runs only when its FEATURE_ flag is 1
# AND its keys are set. Used by scripts/import-catalog.mts and scripts/import-prices.mts.
FEATURE_IGDB=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
FEATURE_PRICECHARTING=
PRICECHARTING_API_KEY=
# Display-only conversion for non-EUR prices (e.g. 0.92). Without it, USD prices are not shown.
PRICE_FX_USD_EUR=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). At least 16 characters.
CRON_SECRET=

# Set to 1 to expose /dev/components in a production build (used by e2e tests)
ENABLE_DEV_PAGES=

# Local dev/e2e only: in-memory accounts and collections when Supabase is NOT configured.
# Ignored when Supabase vars are set, and never active on a Vercel production deployment.
SAVESLOT_MEMORY_BACKEND=

# Copy to .env.local and fill in. Never commit real values.
# Save Slot only — never reuse values from any other project.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Save Slot project in the MerijnBiz organization)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server-only

# External data (later phases, server-only, optional)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PRICECHARTING_API_KEY=

# Protects /api/cron/* (later phases)
CRON_SECRET=

# Set to 1 to expose /dev/components in a production build (used by e2e tests)
ENABLE_DEV_PAGES=

/**
 * Writes supabase/seed.sql from src/data/seed/catalog.ts (the single source of truth).
 * The data is embedded once as JSON and upserted on natural keys, so it is idempotent.
 *
 *   pnpm seed:generate
 */
import { writeFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { seedCompanies, seedGames, seedGenres, seedSeries } from '../src/data/seed/catalog.ts'
import { DEMO_PRICE_DATE, demoPrices } from '../src/data/seed/prices.ts'

const data = {
  companies: seedCompanies.map((c) => ({ slug: c.slug, name: c.name, country: c.country ?? null })),
  genres: seedGenres,
  series: seedSeries,
  games: seedGames.map((g) => ({
    slug: g.slug,
    title: g.title,
    platform: g.compat === 'gb' ? 'gb' : 'gbc',
    compat: g.compat,
    series: g.series ?? null,
    developer: g.developer,
    description: g.description,
    sgb_enhanced: g.features?.sgbEnhanced ?? null,
    rumble: g.features?.rumble ?? null,
    infrared: g.features?.infrared ?? null,
    link_cable: g.features?.linkCable ?? null,
    battery_save: g.features?.batterySave ?? null,
  })),
  game_genres: seedGames.flatMap((g) => g.genres.map((genre) => ({ game: g.slug, genre }))),
  releases: seedGames.flatMap((g) =>
    g.releases.map((r) => ({
      game: g.slug,
      region: r.region,
      local_title: r.localTitle ?? null,
      year: r.year,
      publisher: r.publisher ?? g.publisher,
    })),
  ),
  prices: seedGames.flatMap((g) =>
    g.releases.flatMap((r) => {
      const p = demoPrices(g.slug, r.region)
      return (['loose', 'cib', 'new'] as const).map((grade) => ({
        game: g.slug,
        region: r.region,
        grade,
        cents: p[grade],
      }))
    }),
  ),
}

const json = JSON.stringify(data).replaceAll("'", "''")

const sql = `-- GENERATED by scripts/generate-seed.mts from src/data/seed/catalog.ts. Do not edit by hand.
-- source = seed: hand-checked facts only, year precision, no prices, codes or images.
-- ${seedGames.length} games.

begin;

create temporary table _seed on commit drop as select '${json}'::jsonb as d;

insert into public.companies (slug, name, country)
select x.slug, x.name, x.country
from _seed, jsonb_to_recordset(d->'companies') as x(slug text, name text, country text)
on conflict (slug) do update set name = excluded.name, country = excluded.country;

insert into public.genres (slug, name)
select x.slug, x.name from _seed, jsonb_to_recordset(d->'genres') as x(slug text, name text)
on conflict (slug) do update set name = excluded.name;

insert into public.series (slug, name)
select x.slug, x.name from _seed, jsonb_to_recordset(d->'series') as x(slug text, name text)
on conflict (slug) do update set name = excluded.name;

insert into public.games (slug, title, platform, compat, series_id, developer_id, description,
  sgb_enhanced, rumble, infrared, link_cable, battery_save, source)
select x.slug, x.title, x.platform::public.platform, x.compat::public.cart_compat,
  (select id from public.series s where s.slug = x.series),
  (select id from public.companies c where c.slug = x.developer),
  x.description, x.sgb_enhanced, x.rumble, x.infrared, x.link_cable, x.battery_save, 'seed'
from _seed, jsonb_to_recordset(d->'games') as x(
  slug text, title text, platform text, compat text, series text, developer text, description text,
  sgb_enhanced boolean, rumble boolean, infrared boolean, link_cable boolean, battery_save boolean)
on conflict (slug) do update set
  title = excluded.title, platform = excluded.platform, compat = excluded.compat,
  series_id = excluded.series_id, developer_id = excluded.developer_id, description = excluded.description,
  sgb_enhanced = excluded.sgb_enhanced, rumble = excluded.rumble, infrared = excluded.infrared,
  link_cable = excluded.link_cable, battery_save = excluded.battery_save;

insert into public.game_genres (game_id, genre_id)
select g.id, ge.id
from _seed, jsonb_to_recordset(d->'game_genres') as x(game text, genre text)
join public.games g on g.slug = x.game
join public.genres ge on ge.slug = x.genre
on conflict do nothing;

insert into public.releases (game_id, region, local_title, release_date, release_date_precision, publisher_id, source)
select g.id, x.region::public.region, x.local_title, make_date(x.year, 1, 1), 'year',
  (select id from public.companies c where c.slug = x.publisher), 'seed'
from _seed, jsonb_to_recordset(d->'releases') as x(game text, region text, local_title text, year int, publisher text)
join public.games g on g.slug = x.game
on conflict (game_id, region, coalesce(product_code, '')) do update set
  local_title = excluded.local_title, release_date = excluded.release_date,
  release_date_precision = excluded.release_date_precision, publisher_id = excluded.publisher_id;

-- DEMO prices (source = seed): replaced wholesale on every run.
delete from public.price_points where source = 'seed';
insert into public.price_points (release_id, grade, value_cents, currency, source, observed_at)
select r.id, x.grade::public.price_grade, x.cents, 'EUR', 'seed', '${DEMO_PRICE_DATE}'
from _seed, jsonb_to_recordset(d->'prices') as x(game text, region text, grade text, cents int)
join public.games g on g.slug = x.game
join public.releases r on r.game_id = g.id and r.region = x.region::public.region and r.product_code is null;

commit;
`

const target = fileURLToPath(new URL('../supabase/seed.sql', import.meta.url))
writeFileSync(target, sql)
console.log(`Wrote ${seedGames.length} games to supabase/seed.sql`)
